<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mirte_apple_detector</name>
  <version>0.1.0</version>
  <description>
    Red and green apple detection from a compressed image stream using
    classical colour and shape analysis (no neural network). C++ / rclcpp.
  </description>
  <maintainer email="f.b.jorritsma@student.tudelft.nl">Fedde</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>libopencv-dev</depend>

  <exec_depend>launch_xml</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
